<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd job: run the post-draw routine every Thursday and Sunday at 09:00,
  the morning after each draw.

  Not 22:30 on the draw night itself: that fired 15 min before the cloud
  collector and left the tracked CSVs dirty every time (see
  scripts/monitoring/sync_collector_data.sh). launchd also runs a missed job
  once the Mac wakes, so a closed lid only delays this, it does not skip it.

  Install (from the repo root):
    make install-cron
  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.lotto.postdraw.plist
    rm ~/Library/LaunchAgents/com.lotto.postdraw.plist

  NOTE: __REPO__ is replaced with the absolute repo path by `make install-cron`.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lotto.postdraw</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/monitoring/post_draw.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>__REPO__/logs/post_draw.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/logs/post_draw.log</string>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
</dict>
</plist>
